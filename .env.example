# ==========================================
# Crisol — variables de entorno
# ==========================================
# Copia este archivo a .env y rellena los valores.
# NUNCA commitear .env al repositorio.

# ---------- Backend ----------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://crisol:crisol@localhost:5432/crisol
# BD separada para los tests (conftest la crea automáticamente).
TEST_DATABASE_URL=postgresql+asyncpg://crisol:crisol@localhost:5432/crisol_test
POSTGRES_USER=crisol
POSTGRES_PASSWORD=crisol
POSTGRES_DB=crisol

# ---------- Auth ----------
# Generar SIEMPRE uno nuevo. Mínimo 32 bytes (64 chars hex).
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-local-env
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- MinIO (blob storage) ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RECEIPTS=receipts
MINIO_SECURE=false

# ---------- Ollama (IA local) ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5-vl:7b
OLLAMA_TIMEOUT_SECONDS=120

# ---------- EDGAR (fundamentales del módulo Inversión) ----------
# La SEC exige identificarse en el User-Agent para descargar datos. Sin esto la
# ingesta falla con un mensaje claro en vez de recibir un 403 a mitad. Sólo
# viaja en la cabecera: no se guarda en BD ni en los payloads cacheados.
EDGAR_IDENTITY=Nombre Apellido email@dominio.com
# Payloads crudos de la SEC (evidencia de auditoría). Relativa a backend/.
EDGAR_CACHE_DIR=data/edgar_cache
EDGAR_FILINGS_BACK=5
EDGAR_TIMEOUT_SECONDS=60

# ---------- Precios (módulo Inversión) ----------
# Sin FINNHUB_API_KEY las cotizaciones y la búsqueda externa quedan DESACTIVADAS
# (la cartera funciona con datos manuales; el valor de mercado sale "sin
# cotización"). No rompe nada.
PRICE_PROVIDER=finnhub
FINNHUB_API_KEY=
PRICE_TTL_HOURS=24
PRICE_TIMEOUT_SECONDS=15

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---------- Frontend web (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Frontend mobile (Expo) ----------
EXPO_PUBLIC_API_URL=http://localhost:8000
