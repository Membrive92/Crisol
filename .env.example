# ==========================================
# Finanzas App — variables de entorno
# ==========================================
# Copia este archivo a .env y rellena los valores.
# NUNCA commitear .env al repositorio.

# ---------- Backend ----------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://finanzas:finanzas@localhost:5432/finanzas
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=finanzas
POSTGRES_DB=finanzas

# ---------- Auth ----------
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-local-env
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- MinIO (blob storage) ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RECEIPTS=receipts
MINIO_SECURE=false

# ---------- Ollama (IA local) ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5-vl:7b
OLLAMA_TIMEOUT_SECONDS=120

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---------- Frontend web (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Frontend mobile (Expo) ----------
EXPO_PUBLIC_API_URL=http://localhost:8000
