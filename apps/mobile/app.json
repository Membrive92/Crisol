{
  "expo": {
    "name": "Crisol",
    "slug": "crisol",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "crisol",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crisol.app"
    },
    "android": {
      "package": "com.crisol.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f0f0f"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "La app necesita acceder a la cámara para capturar tickets.",
          "photosPermission": "La app necesita acceder a tu galería para subir tickets."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
